diff --git a/dm/host/front_mac.m b/dm/host/front_mac.m
index b407953..507a072 100644
--- a/dm/host/front_mac.m
+++ b/dm/host/front_mac.m
@@ -483,11 +483,18 @@ void front_picture_shape(int w, int h) { if (w > 0 && h > 0) g_picture_aspect =
 - (void)mouseUp:(NSEvent *)e { (void)e; front_controllers_mouse(NULL); }
 // The drawable follows the view in pixels: a layer assigned to a layer-backed view kept the drawable at the first window's 1280x720 in fullscreen too, so the game picture was
 // scaled down to it and up again by the compositor
+// DM_OUTPUT_HEIGHT=<n> (the settings window's Fullscreen resolution): in fullscreen the drawable is no larger than the size at which the game's 16:9 picture is n pixels
+// high (1440: 2560x1440, 1080: 1920x1080 inside it), and the compositor scales it to the screen; 0 or unset keeps the screen's own pixels. A window keeps its own pixels
 - (void)fitDrawable {
     CAMetalLayer *l = (CAMetalLayer *)self.layer; if (![l isKindOfClass:CAMetalLayer.class] || !self.window) return;
     l.contentsScale = self.window.backingScaleFactor;
-    NSSize px = [self convertSizeToBacking:self.bounds.size]; if (px.width < 1 || px.height < 1 || CGSizeEqualToSize(l.drawableSize, px)) return;
-    l.drawableSize = px; LOG("front end: drawable %.0fx%.0f", px.width, px.height);
+    NSSize px = [self convertSizeToBacking:self.bounds.size]; if (px.width < 1 || px.height < 1) return;
+    static int cap = -1; if (cap < 0) { const char *e = getenv("DM_OUTPUT_HEIGHT"); cap = e ? atoi(e) : 0; if (cap < 0) cap = 0; }
+    double picture = fmin(px.height, px.width * 9 / 16);   // the height of the 16:9 picture inside the view
+    int capped = cap && (self.window.styleMask & NSWindowStyleMaskFullScreen) && picture > cap;
+    if (capped) px = NSMakeSize(round(px.width * cap / picture), round(px.height * cap / picture));
+    if (CGSizeEqualToSize(l.drawableSize, px)) return;
+    l.drawableSize = px; LOG("front end: drawable %.0fx%.0f%s", px.width, px.height, capped ? " (DM_OUTPUT_HEIGHT)" : "");
 }
 - (void)setFrameSize:(NSSize)s { [super setFrameSize:s]; [self fitDrawable]; }
 - (void)viewDidChangeBackingProperties { [super viewDidChangeBackingProperties]; [self fitDrawable]; }
@@ -1502,8 +1509,8 @@ void front_run(void (*guest)(void)) {
         [nc addObserverForName:NSApplicationDidChangeScreenParametersNotification object:nil queue:nil usingBlock:^(NSNotification *n) { (void)n; screen_refresh(win.screen); }];
         // Entering and leaving fullscreen: the layer is layer-backed, so its frame (and with it the drawable) follows the
         // content view by itself; only the scale factor has to be carried over to the screen the window ended up on. The screen's rate is matched in fullscreen only (screen_match_apply)
-        [nc addObserverForName:NSWindowDidEnterFullScreenNotification object:win queue:nil usingBlock:^(NSNotification *n) { (void)n; screen_refresh(win.screen); g_fullscreen = 1; g_layer.contentsScale = win.backingScaleFactor; screen_match_apply(); }];
-        [nc addObserverForName:NSWindowDidExitFullScreenNotification object:win queue:nil usingBlock:^(NSNotification *n) { (void)n; g_fullscreen = 0; screen_refresh(win.screen); g_layer.contentsScale = win.backingScaleFactor; screen_match_apply(); }];
+        [nc addObserverForName:NSWindowDidEnterFullScreenNotification object:win queue:nil usingBlock:^(NSNotification *n) { (void)n; screen_refresh(win.screen); g_fullscreen = 1; g_layer.contentsScale = win.backingScaleFactor; [(DmGameView *)win.contentView fitDrawable]; screen_match_apply(); }];
+        [nc addObserverForName:NSWindowDidExitFullScreenNotification object:win queue:nil usingBlock:^(NSNotification *n) { (void)n; g_fullscreen = 0; screen_refresh(win.screen); g_layer.contentsScale = win.backingScaleFactor; [(DmGameView *)win.contentView fitDrawable]; screen_match_apply(); }];
         // DM_FOCUS_KEEP (on by default, =0 turns it off): the game stays in focus while its window is up, whichever app is active. Tears of the Kingdom and Ocarina of Time
         // stop presenting out of focus, so clicking into another app read as a hang (no frame and no sound after the last focus change)
         static int keep = -1; if (keep < 0) keep = !getenv("DM_FOCUS_KEEP") || atoi(getenv("DM_FOCUS_KEEP"));
