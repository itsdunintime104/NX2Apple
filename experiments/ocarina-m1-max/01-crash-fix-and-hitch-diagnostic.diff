+static void slowcb_note(uint64_t f, uint64_t fence, double g0, double g1, const char *what) {
+    static _Atomic int n;
+    if (!(g0 > 0) || g1 - g0 < 0.020 || atomic_fetch_add(&n, 1) >= 200) return;
+    MLOG("[slowcb] frame %llu fence %llu: the GPU held one command buffer for %.1f ms (start %.3f s, end %.3f s): %s", (unsigned long long)f, (unsigned long long)fence,
